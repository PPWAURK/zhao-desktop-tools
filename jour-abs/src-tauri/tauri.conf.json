{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super Xiaona",
  "version": "1.1.1",
  "identifier": "com.zhaogroupe.jourabs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Super Xiaona",
        "width": 1120,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGRTY2REMxOTk0RUQwRkQKUldUOTBFNlp3VzNtajBSU0prY3BZV0hEWVc1V1l5TjB0VzMveUNlT1NWVWlxdUVPcm5BaDgzekUK",
      "endpoints": [
        "https://github.com/PPWAURK/zhao-desktop-tools/releases/download/super-xiaona-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
